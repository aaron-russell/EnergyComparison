{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "renewable": {
      "enum": ["yes", "no", "unknown"]
    },
    "annualCredit": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$",
      "maxLength": 30
    },
    "electricity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standing": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "maxLength": 30
        },
        "bands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 336,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "days": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "start": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):(00|30)$"
              },
              "end": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):(00|30)$"
              },
              "rate": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "maxLength": 30
              }
            },
            "required": ["name", "days", "start", "end", "rate"]
          }
        }
      },
      "required": ["standing", "bands"]
    },
    "gas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standing": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "maxLength": 30
        },
        "rate": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "maxLength": 30
        }
      },
      "required": ["standing", "rate"]
    },
    "ev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["override", "discount"]
        },
        "rate": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "maxLength": 30
        }
      },
      "required": ["mode", "rate"]
    }
  },
  "required": ["version", "id", "name", "renewable", "annualCredit"],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Energy Replay tariff v1",
  "description": "VAT-inclusive decimal pence. Monday=1. End exclusive; same start/end means 24 hours. Overnight days refer to starting day. Unknown rules rejected."
}
