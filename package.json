{
  "name": "energy-replay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:app": "tsc -b && vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs --outDir dist/docs && node scripts/update-docs-csp.mjs",
    "docs:check": "npm run docs:build && node scripts/check-docs.mjs",
    "audit:links": "npm run build && node scripts/audit-internal-links.mjs",
    "build": "npm run build:app && npm run docs:build && node scripts/generate-sitemap.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint . --type-aware --max-warnings=0",
    "lint:fix": "oxlint . --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && node scripts/check-docs.mjs && node scripts/audit-internal-links.mjs",
    "schema:generate": "node scripts/generate-validator.mjs",
    "prebuild": "npm run schema:generate"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "ajv": "^8.20.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.49.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
